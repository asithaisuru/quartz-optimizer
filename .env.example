# Copy this file to .env and adjust paths
STORAGE_PATH=./
HOST=0.0.0.0
PORT=8000
# Default research/demo path: one CPU thread for sparse COLMAP stages.
# Set false intentionally to restore eight sparse threads. Dense CUDA is unchanged.
# This reduces nondeterminism; the full reconstruction is not bitwise deterministic.
RECONSTRUCTION_REPRODUCIBLE_MODE=true
